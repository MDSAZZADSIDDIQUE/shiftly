# Supabase project → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Lets the fingerprint terminal endpoint save scans. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Deployment (deploy/docker-compose.yml)
# Domain for the dashboard (HTTPS is automatic), or :80 for plain HTTP.
SITE_ADDRESS=:80
# What the Devices page tells you to type into the terminal.
DEVICE_SERVER_HOST=
DEVICE_SERVER_PORT=8080
