# Supabase project → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Lets the fingerprint terminal endpoint save scans. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Each business is a subdomain of this (parkway.localhost:3000 locally); the bare domain is the platform admin.
ROOT_DOMAIN=localhost
# Optional: the port the Terminals page tells you to type into the fingerprint terminal (default 80).
DEVICE_SERVER_PORT=
# Deployment generates its own values on the server: see deploy/setup-server.sh.
